<%- include('header') %>

<main class="flex-1 max-w-5xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-6">
    <a href="/admin" class="text-sm font-medium text-slate-500 hover:text-slate-800 transition inline-flex items-center">
      &larr; Back to Dashboard
    </a>
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mt-2">
      <div>
        <h1 class="text-2xl font-bold text-slate-900"><%= customer.name %></h1>
        <p class="text-sm text-slate-500 mt-0.5">
          <%= customer.jobs.length %> currently active open job<%= customer.jobs.length === 1 ? '' : 's' %>
        </p>
      </div>

      <!-- Current Response Status Badge -->
      <div>
        <% if (customer.reviewRequest && customer.reviewRequest.status === 'Confirmed') { %>
          <span class="inline-flex items-center px-3 py-1.5 rounded-lg text-sm font-bold bg-emerald-100 text-emerald-800 border border-emerald-300">
            <svg class="w-4 h-4 mr-1.5 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            Confirmed All Dates
          </span>
        <% } else if (customer.reviewRequest && customer.reviewRequest.status === 'Changes Submitted') { %>
          <span class="inline-flex items-center px-3 py-1.5 rounded-lg text-sm font-bold bg-amber-100 text-amber-900 border border-amber-300">
            <svg class="w-4 h-4 mr-1.5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
            Changes Submitted by Customer
          </span>
        <% } else if (customer.reviewRequest && customer.reviewRequest.status === 'Awaiting Response') { %>
          <span class="inline-flex items-center px-3 py-1.5 rounded-lg text-sm font-bold bg-blue-100 text-blue-800 border border-blue-200">
            <svg class="w-4 h-4 mr-1.5 text-blue-600 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            Awaiting Customer Response
          </span>
        <% } else { %>
          <span class="inline-flex items-center px-3 py-1.5 rounded-lg text-sm font-semibold bg-slate-100 text-slate-700 border border-slate-200">
            Link Generated &bull; Not Sent
          </span>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Unique Review Link Card -->
  <div class="bg-white rounded-xl border border-slate-200 p-5 shadow-sm mb-8">
    <div class="flex items-center justify-between mb-3">
      <div class="flex items-center space-x-2">
        <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
        </svg>
        <span class="font-bold text-slate-900 text-sm">Customer Unique Review Link</span>
      </div>
      <% if (customer.reviewRequest && customer.reviewRequest.sent_at_formatted) { %>
        <span class="text-xs text-slate-500">Sent on: <%= customer.reviewRequest.sent_at_formatted %></span>
      <% } %>
    </div>

    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2">
      <div class="relative flex-1">
        <input 
          type="text" 
          readonly 
          id="reviewUrlInput"
          value="<%= reviewUrl %>"
          class="w-full bg-slate-50 border border-slate-300 rounded-lg px-3 py-2 text-xs sm:text-sm font-mono text-slate-700 select-all focus:outline-none focus:ring-2 focus:ring-emerald-500"
        />
      </div>

      <button 
        onclick="copyLink()" 
        id="copyBtn"
        class="inline-flex items-center justify-center px-4 py-2 text-sm font-semibold rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white shadow-sm transition whitespace-nowrap"
      >
        <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
        </svg>
        <span id="copyBtnText">Copy Link</span>
      </button>

      <a 
        href="<%= reviewUrl %>" 
        target="_blank"
        class="inline-flex items-center justify-center px-3.5 py-2 text-sm font-semibold rounded-lg border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 transition whitespace-nowrap"
        title="Open review link in a new tab"
      >
        <svg class="w-4 h-4 mr-1 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
        </svg>
        <span>Preview Customer View</span>
      </a>

      <form action="/admin/customers/<%= customer.id %>/mark-sent" method="POST" class="inline">
        <button 
          type="submit"
          class="w-full inline-flex items-center justify-center px-3.5 py-2 text-sm font-semibold rounded-lg border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 transition whitespace-nowrap"
          title="Mark link as sent to customer"
        >
          <svg class="w-4 h-4 mr-1 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
          </svg>
          <span>Mark as Sent</span>
        </button>
      </form>
    </div>
    <p class="text-xs text-slate-400 mt-2">
      Paste this link into an email to <%= customer.name %>. No login or password is required for the client.
    </p>
  </div>

  <!-- Customer Response Details Panel (If responded) -->
  <% if (customer.latestResponse) { %>
    <div class="mb-8 rounded-xl border <%= customer.latestResponse.response_type === 'CHANGES_SUBMITTED' ? 'border-amber-300 bg-amber-50/40' : 'border-emerald-300 bg-emerald-50/40' %> p-6 shadow-sm">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-4 border-b <%= customer.latestResponse.response_type === 'CHANGES_SUBMITTED' ? 'border-amber-200' : 'border-emerald-200' %> gap-2">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider <%= customer.latestResponse.response_type === 'CHANGES_SUBMITTED' ? 'text-amber-700' : 'text-emerald-700' %>">
            Customer Response Received
          </span>
          <h2 class="text-lg font-bold text-slate-900 mt-0.5">
            <% if (customer.latestResponse.response_type === 'CONFIRMED_ALL') { %>
              Customer confirmed ALL current required dates
            <% } else { %>
              Customer submitted date changes
            <% } %>
          </h2>
        </div>
        <div class="text-xs text-slate-600 font-medium">
          Response Timestamp: <strong><%= customer.latestResponse.responded_at_formatted %></strong>
        </div>
      </div>

      <% if (customer.latestResponse.response_type === 'CHANGES_SUBMITTED' && customer.latestResponse.items && customer.latestResponse.items.length > 0) { %>
        <div class="mt-4">
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700 mb-3">
            Requested Date Modifications:
          </h3>
          <div class="bg-white rounded-lg border border-amber-200 overflow-hidden shadow-sm">
            <table class="min-w-full divide-y divide-slate-200 text-xs sm:text-sm">
              <thead class="bg-amber-100/60 text-amber-900 text-xs font-semibold">
                <tr>
                  <th class="px-4 py-2.5 text-left">Job / PO</th>
                  <th class="px-4 py-2.5 text-left">Description</th>
                  <th class="px-4 py-2.5 text-left">Original Date</th>
                  <th class="px-4 py-2.5 text-left">Customer Requested Date</th>
                  <th class="px-4 py-2.5 text-left">Notes / Contact</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 bg-white">
                <% customer.latestResponse.items.forEach(function(item) { %>
                  <tr class="<%= item.is_changed ? 'bg-amber-50/60' : '' %>">
                    <td class="px-4 py-3 font-semibold text-slate-900 whitespace-nowrap">
                      <%= item.purchase_order || item.job_order_number %>
                    </td>
                    <td class="px-4 py-3 text-slate-700">
                      <%= item.description %>
                    </td>
                    <td class="px-4 py-3 text-slate-500 whitespace-nowrap">
                      <span class="line-through decoration-slate-400 font-medium"><%= item.original_date_formatted %></span>
                    </td>
                    <td class="px-4 py-3 whitespace-nowrap">
                      <% if (item.is_changed && item.new_date_formatted) { %>
                        <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-bold bg-amber-100 text-amber-900 border border-amber-300">
                          <%= item.new_date_formatted %>
                        </span>
                      <% } else { %>
                        <span class="text-slate-400 italic">Unchanged</span>
                      <% } %>
                    </td>
                    <td class="px-4 py-3 text-xs">
                      <% if (item.contact_requested) { %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold bg-red-100 text-red-700 mb-1">
                          Contact Requested
                        </span>
                      <% } %>
                      <% if (item.customer_comment) { %>
                        <div class="text-slate-700 italic">"<%= item.customer_comment %>"</div>
                      <% } else if (!item.contact_requested) { %>
                        <span class="text-slate-400">-</span>
                      <% } %>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
          <div class="mt-3 text-xs text-amber-800 bg-amber-100/70 p-2.5 rounded-lg border border-amber-200">
            <strong>Next step:</strong> Please review these requested dates and manually update Ostendo accordingly.
          </div>
        </div>
      <% } %>
    </div>
  <% } %>

  <!-- Current Open Jobs Table -->
  <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="p-4 sm:p-5 border-b border-slate-200 bg-slate-50 flex items-center justify-between">
      <div>
        <h2 class="text-base font-bold text-slate-900">Current Open Job Orders in Ostendo</h2>
        <p class="text-xs text-slate-500 mt-0.5">These are the jobs visible on the customer's review link.</p>
      </div>
      <span class="px-2.5 py-1 bg-slate-200/70 text-slate-700 font-bold text-xs rounded-full">
        <%= customer.jobs.length %> Jobs
      </span>
    </div>

    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200 text-sm">
        <thead class="bg-slate-50 text-slate-600 text-xs uppercase font-semibold">
          <tr>
            <th class="px-6 py-3 text-left">Purchase Order</th>
            <th class="px-6 py-3 text-left">Description</th>
            <th class="px-6 py-3 text-left">Required Date</th>
            <th class="px-6 py-3 text-center">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 bg-white">
          <% customer.jobs.forEach(function(job) { %>
            <tr class="hover:bg-slate-50/70 transition">
              <td class="px-6 py-4 font-semibold text-slate-900 whitespace-nowrap">
                <%= job.purchase_order && job.purchase_order !== 'TBA' ? job.purchase_order : 'TBA' %>
              </td>
              <td class="px-6 py-4 text-slate-700 font-medium">
                <%= job.description %>
              </td>
              <td class="px-6 py-4 font-bold text-slate-900 whitespace-nowrap">
                <%= job.required_date_formatted %>
              </td>
              <td class="px-6 py-4 text-center">
                <span class="inline-flex px-2 py-0.5 rounded text-xs font-bold bg-emerald-100 text-emerald-800">
                  Open
                </span>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</main>

<script>
  function copyLink() {
    const input = document.getElementById('reviewUrlInput');
    input.select();
    input.setSelectionRange(0, 99999);
    navigator.clipboard.writeText(input.value).then(() => {
      const btn = document.getElementById('copyBtn');
      const btnText = document.getElementById('copyBtnText');
      const orig = btnText.textContent;
      btnText.textContent = 'Copied!';
      btn.classList.add('bg-emerald-700');
      setTimeout(() => {
        btnText.textContent = orig;
        btn.classList.remove('bg-emerald-700');
      }, 2000);
    });
  }
</script>
<%- include('footer') %>
