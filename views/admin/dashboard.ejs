<%- include('header') %>

<main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Top Banner / Alert if query param -->
  <% if (typeof successMessage !== 'undefined' && successMessage) { %>
    <div class="mb-6 rounded-lg bg-emerald-50 border border-emerald-200 p-4 text-emerald-800 flex items-center justify-between shadow-sm">
      <div class="flex items-center space-x-2">
        <svg class="w-5 h-5 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <span class="text-sm font-medium"><%= successMessage %></span>
      </div>
      <button onclick="this.parentElement.remove()" class="text-emerald-600 hover:text-emerald-800 text-sm font-semibold">&times;</button>
    </div>
  <% } %>

  <!-- Title & Upload CTA -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-6 border-b border-slate-200 gap-4">
    <div>
      <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Job Follow Up Dashboard</h1>
      <p class="text-sm text-slate-500 mt-1">
        Monitor customer required date confirmations and review requests.
        <% if (stats.latestImport) { %>
          <span class="inline-block ml-2 px-2 py-0.5 text-xs bg-slate-100 text-slate-600 rounded">
            Latest snapshot: <%= stats.latestImport.filename %> (<%= stats.latestImport.open_jobs_count %> open jobs)
          </span>
        <% } %>
      </p>
    </div>
    <div class="flex items-center space-x-3">
      <button 
        type="button" 
        onclick="toggleDomainModal()"
        class="inline-flex items-center px-3.5 py-2 text-xs font-semibold rounded-lg text-slate-700 bg-white border border-slate-300 hover:bg-slate-50 shadow-sm transition"
        title="Configure public internet domain for customer links"
      >
        <svg class="w-4 h-4 mr-1.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
        </svg>
        <span>Public Domain: <strong class="text-slate-900 font-mono"><%= configuredBaseUrl ? configuredBaseUrl : (host.includes('localhost') ? 'Localhost (Click to configure)' : host) %></strong></span>
      </button>

      <a href="/admin/upload" class="inline-flex items-center px-4 py-2 text-sm font-semibold rounded-lg text-white bg-emerald-600 hover:bg-emerald-500 shadow-sm transition">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
        </svg>
        Upload Job Orders (.xls / .xlsx)
      </a>
    </div>
  </div>

  <% if (host.includes('localhost') && !configuredBaseUrl) { %>
    <!-- Notice for Localhost -->
    <div class="mt-4 p-3.5 bg-blue-50 border border-blue-200 rounded-xl text-xs text-blue-900 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 shadow-sm">
      <div class="flex items-center space-x-2">
        <svg class="w-4 h-4 text-blue-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>
          Customer links are currently set to <code class="font-bold bg-blue-100/70 px-1 py-0.5 rounded text-blue-800">localhost</code>. To let external customers open links from their phones/offices, configure your public internet domain or tunnel URL.
        </span>
      </div>
      <button 
        type="button" 
        onclick="toggleDomainModal()" 
        class="whitespace-nowrap px-3 py-1 bg-blue-600 text-white font-semibold rounded-md hover:bg-blue-500 transition text-xs shadow-xs"
      >
        Set Public Domain
      </button>
    </div>
  <% } %>

  <!-- KPI Cards -->
  <div class="grid grid-cols-2 md:grid-cols-5 gap-4 my-6">
    <a href="/admin" class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm hover:border-slate-300 transition">
      <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Total Open Jobs</div>
      <div class="text-2xl font-extrabold text-slate-900 mt-1"><%= stats.openJobs %></div>
      <div class="text-xs text-slate-400 mt-0.5"><%= stats.customersCount %> customers</div>
    </a>

    <a href="/admin?status=Awaiting+Response" class="bg-white p-4 rounded-xl border border-blue-200 shadow-sm hover:border-blue-300 transition <%= currentStatus === 'Awaiting Response' ? 'ring-2 ring-blue-500' : '' %>">
      <div class="text-xs font-semibold text-blue-600 uppercase tracking-wider">Awaiting Response</div>
      <div class="text-2xl font-extrabold text-blue-900 mt-1"><%= stats.awaitingCount %></div>
      <div class="text-xs text-blue-500 mt-0.5">Links sent to clients</div>
    </a>

    <a href="/admin?status=Confirmed" class="bg-white p-4 rounded-xl border border-emerald-200 shadow-sm hover:border-emerald-300 transition <%= currentStatus === 'Confirmed' ? 'ring-2 ring-emerald-500' : '' %>">
      <div class="text-xs font-semibold text-emerald-600 uppercase tracking-wider">Confirmed</div>
      <div class="text-2xl font-extrabold text-emerald-900 mt-1"><%= stats.confirmedCount %></div>
      <div class="text-xs text-emerald-500 mt-0.5">All dates accepted</div>
    </a>

    <a href="/admin?status=Changes+Submitted" class="bg-white p-4 rounded-xl border border-amber-200 shadow-sm hover:border-amber-300 transition <%= currentStatus === 'Changes Submitted' ? 'ring-2 ring-amber-500' : '' %>">
      <div class="text-xs font-semibold text-amber-600 uppercase tracking-wider">Changes Submitted</div>
      <div class="text-2xl font-extrabold text-amber-900 mt-1"><%= stats.changesCount %></div>
      <div class="text-xs text-amber-600 mt-0.5">Requires Ostendo update</div>
    </a>

    <a href="/admin?status=Not+Sent" class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm hover:border-slate-300 transition <%= currentStatus === 'Not Sent' ? 'ring-2 ring-slate-400' : '' %>">
      <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Not Sent</div>
      <div class="text-2xl font-extrabold text-slate-700 mt-1"><%= stats.notSentCount %></div>
      <div class="text-xs text-slate-400 mt-0.5">Ready to dispatch</div>
    </a>
  </div>

  <!-- Search & Filter Controls -->
  <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden mb-6">
    <div class="p-4 border-b border-slate-200 bg-slate-50/50 flex flex-col sm:flex-row items-center justify-between gap-4">
      <!-- Search Input -->
      <div class="relative w-full sm:w-80">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <svg class="h-4 w-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </div>
        <input 
          type="text" 
          id="customerSearch" 
          placeholder="Filter customer name..." 
          value="<%= searchQuery || '' %>"
          class="block w-full pl-9 pr-3 py-1.5 border border-slate-300 rounded-lg text-sm placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500"
          oninput="handleSearch(this.value)"
        >
      </div>

      <!-- Status Tabs -->
      <div class="flex items-center space-x-1.5 overflow-x-auto w-full sm:w-auto">
        <% const statuses = ['All', 'Not Sent', 'Awaiting Response', 'Confirmed', 'Changes Submitted']; %>
        <% statuses.forEach(function(s) { %>
          <a 
            href="/admin?status=<%= encodeURIComponent(s) %><%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>"
            class="px-3 py-1 text-xs font-medium rounded-lg whitespace-nowrap transition <%= (currentStatus === s || (!currentStatus && s === 'All')) ? 'bg-slate-900 text-white shadow-sm' : 'bg-white text-slate-600 hover:bg-slate-100 border border-slate-200' %>"
          >
            <%= s %>
          </a>
        <% }); %>
      </div>
    </div>

    <!-- Customers Table -->
    <% if (customers.length === 0) { %>
      <div class="p-12 text-center">
        <svg class="mx-auto h-12 w-12 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
        <h3 class="mt-2 text-sm font-semibold text-slate-800">No customers found</h3>
        <p class="mt-1 text-sm text-slate-500">
          <% if (stats.openJobs === 0) { %>
            Upload your Ostendo Job Orders export to get started.
          <% } else { %>
            No customers match the current filter or search criteria.
          <% } %>
        </p>
        <div class="mt-4">
          <a href="/admin/upload" class="inline-flex items-center px-4 py-2 text-sm font-medium rounded-lg text-white bg-emerald-600 hover:bg-emerald-500 shadow-sm">
            Upload Job Orders
          </a>
        </div>
      </div>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200 text-sm">
          <thead class="bg-slate-50 text-slate-600 text-xs uppercase font-semibold">
            <tr>
              <th scope="col" class="px-6 py-3 text-left">Customer</th>
              <th scope="col" class="px-4 py-3 text-center">Open Jobs</th>
              <th scope="col" class="px-6 py-3 text-left">Response Status</th>
              <th scope="col" class="px-6 py-3 text-left">Last Sent</th>
              <th scope="col" class="px-6 py-3 text-left">Last Response</th>
              <th scope="col" class="px-6 py-3 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 bg-white" id="customerTableBody">
            <% customers.forEach(function(cust) { %>
              <tr class="hover:bg-slate-50/80 transition customer-row" data-name="<%= cust.name.toLowerCase() %>">
                <td class="px-6 py-4 font-semibold text-slate-900">
                  <a href="/admin/customers/<%= cust.id %>" class="hover:text-emerald-600 transition flex items-center group">
                    <span><%= cust.name %></span>
                    <svg class="w-4 h-4 ml-1.5 opacity-0 group-hover:opacity-100 text-emerald-600 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </a>
                </td>
                <td class="px-4 py-4 text-center">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-700">
                    <%= cust.open_jobs_count %>
                  </span>
                </td>
                <td class="px-6 py-4">
                  <% if (cust.review_status === 'Confirmed') { %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-semibold bg-emerald-100 text-emerald-800 border border-emerald-200">
                      <svg class="w-3 h-3 mr-1 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                      </svg>
                      Confirmed
                    </span>
                  <% } else if (cust.review_status === 'Changes Submitted') { %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-semibold bg-amber-100 text-amber-900 border border-amber-300">
                      <svg class="w-3 h-3 mr-1 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                      </svg>
                      Changes Submitted
                      <% if (cust.changed_dates_count > 0) { %>
                        <span class="ml-1 text-[11px] font-normal text-amber-800">(<%= cust.changed_dates_count %> changed)</span>
                      <% } %>
                    </span>
                  <% } else if (cust.review_status === 'Awaiting Response') { %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-semibold bg-blue-100 text-blue-800 border border-blue-200">
                      <svg class="w-3 h-3 mr-1 text-blue-600 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                      </svg>
                      Awaiting Response
                    </span>
                  <% } else { %>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-medium bg-slate-100 text-slate-600 border border-slate-200">
                      Not Sent
                    </span>
                  <% } %>
                </td>
                <td class="px-6 py-4 text-slate-500 text-xs">
                  <%= cust.sent_at_formatted %>
                </td>
                <td class="px-6 py-4 text-slate-500 text-xs">
                  <%= cust.responded_at_formatted %>
                </td>
                <td class="px-6 py-4 text-right space-x-2 whitespace-nowrap">
                  <button 
                    onclick="copyReviewLink('<%= host %>/review/<%= cust.token %>', this)"
                    class="inline-flex items-center px-2.5 py-1.5 text-xs font-medium rounded border border-slate-300 text-slate-700 bg-white hover:bg-slate-50 transition"
                    title="Copy unique review link to clipboard"
                  >
                    <svg class="w-3.5 h-3.5 mr-1 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                    </svg>
                    <span>Copy Link</span>
                  </button>

                  <a 
                    href="/admin/customers/<%= cust.id %>" 
                    class="inline-flex items-center px-3 py-1.5 text-xs font-semibold rounded bg-slate-900 text-white hover:bg-slate-800 transition"
                  >
                    View Jobs &rarr;
                  </a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</main>

<!-- Toast Notification -->
<div id="toast" class="fixed bottom-5 right-5 z-50 transform translate-y-16 opacity-0 transition-all duration-300 bg-slate-900 text-white px-4 py-2.5 rounded-lg shadow-lg text-sm flex items-center space-x-2">
  <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
  </svg>
  <span id="toastMessage">Copied link to clipboard!</span>
</div>

<script>
  function showToast(msg) {
    const toast = document.getElementById('toast');
    const toastMsg = document.getElementById('toastMessage');
    toastMsg.textContent = msg;
    toast.classList.remove('translate-y-16', 'opacity-0');
    setTimeout(() => {
      toast.classList.add('translate-y-16', 'opacity-0');
    }, 2500);
  }

  function copyReviewLink(url, btn) {
    navigator.clipboard.writeText(url).then(() => {
      const origText = btn.innerHTML;
      btn.innerHTML = `<svg class="w-3.5 h-3.5 mr-1 text-emerald-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg><span class="text-emerald-600 font-semibold">Copied!</span>`;
      showToast('Review link copied! You can paste it into an email.');
      setTimeout(() => {
        btn.innerHTML = origText;
      }, 2000);
    });
  }

  function handleSearch(query) {
    const q = query.toLowerCase().trim();
    const rows = document.querySelectorAll('.customer-row');
    rows.forEach(r => {
      const name = r.getAttribute('data-name') || '';
      if (!q || name.includes(q)) {
        r.style.display = '';
      } else {
        r.style.display = 'none';
      }
    });
  }

  function toggleDomainModal() {
    const m = document.getElementById('domainModal');
    m.classList.toggle('hidden');
  }
</script>

<!-- Public Domain Configuration Modal -->
<div id="domainModal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl border border-slate-200">
    <div class="flex items-center justify-between pb-3 border-b border-slate-100">
      <h3 class="text-lg font-bold text-slate-900">Configure Public Base URL</h3>
      <button onclick="toggleDomainModal()" class="text-slate-400 hover:text-slate-600 text-xl font-bold">&times;</button>
    </div>

    <p class="text-xs text-slate-500 mt-3 leading-relaxed">
      Set the public web address where this app is hosted or tunneled. All generated customer review links will use this domain so customers can open them from any phone, office, or device outside your network.
    </p>

    <form action="/admin/settings/base-url" method="POST" class="mt-4 space-y-4">
      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1" for="baseUrlInput">
          Public Base URL (including https://)
        </label>
        <input 
          type="url" 
          name="baseUrl" 
          id="baseUrlInput" 
          value="<%= configuredBaseUrl || (host.includes('localhost') ? '' : host) %>"
          placeholder="https://followup.plasgain.com.au or https://xxxx.localtunnel.me"
          class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm font-mono placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500"
        />
        <p class="text-[11px] text-slate-400 mt-1">
          Leave blank to automatically detect based on the web browser's incoming request.
        </p>
      </div>

      <div class="p-3 bg-slate-50 rounded-xl border border-slate-200 text-xs text-slate-600 space-y-1">
        <div class="font-bold text-slate-800">Options for internet access:</div>
        <div>&bull; <strong>Custom Domain:</strong> e.g. <code class="bg-white px-1 py-0.5 rounded border">https://followup.plasgain.com.au</code> (via DNS/reverse proxy or cloud host)</div>
        <div>&bull; <strong>Cloud Host:</strong> e.g. <code class="bg-white px-1 py-0.5 rounded border">https://plasgain-jobs.onrender.com</code></div>
        <div>&bull; <strong>Instant Tunnel:</strong> e.g. using <code class="bg-white px-1 py-0.5 rounded border">npx localtunnel --port 3000</code> or Cloudflare Tunnel</div>
      </div>

      <div class="flex items-center justify-end space-x-3 pt-3 border-t border-slate-100">
        <button 
          type="button" 
          onclick="toggleDomainModal()" 
          class="px-4 py-2 text-xs font-semibold rounded-lg text-slate-600 hover:bg-slate-100 border border-slate-200"
        >
          Cancel
        </button>
        <button 
          type="submit" 
          class="px-5 py-2 text-xs font-bold rounded-lg text-white bg-emerald-600 hover:bg-emerald-500 shadow-sm transition"
        >
          Save Domain
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('footer') %>
