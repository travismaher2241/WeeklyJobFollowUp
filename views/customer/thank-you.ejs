<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dates Confirmed | Plasgain</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-full flex flex-col justify-center items-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full bg-white rounded-3xl p-8 border border-slate-200 shadow-xl text-center">
    
    <!-- Success Icon -->
    <div class="w-20 h-20 mx-auto rounded-full <%= type === 'changes' ? 'bg-amber-100 text-amber-600' : 'bg-emerald-100 text-emerald-600' %> flex items-center justify-center mb-6 shadow-inner">
      <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
      </svg>
    </div>

    <!-- Main Message -->
    <h1 class="text-2xl font-black text-slate-900 tracking-tight">
      <% if (type === 'changes') { %>
        Thanks — your requested changes have been received!
      <% } else { %>
        Thanks — your current required dates have been confirmed!
      <% } %>
    </h1>

    <p class="text-sm text-slate-600 mt-3 leading-relaxed">
      <% if (type === 'changes') { %>
        We have recorded your requested dates for <strong class="text-slate-900"><%= customerName %></strong>. Our production team will review the amendments against our schedule.
      <% } else { %>
        We have confirmed your open order schedule for <strong class="text-slate-900"><%= customerName %></strong>. Our manufacturing and delivery will proceed to match these dates.
      <% } %>
    </p>

    <!-- Details Box -->
    <div class="mt-6 p-4 rounded-2xl bg-slate-50 border border-slate-200 text-left text-xs text-slate-600 space-y-1.5">
      <div class="flex justify-between">
        <span class="text-slate-400">Customer:</span>
        <span class="font-bold text-slate-800"><%= customerName %></span>
      </div>
      <div class="flex justify-between">
        <span class="text-slate-400">Recorded:</span>
        <span class="font-semibold text-slate-800"><%= respondedAtFormatted %></span>
      </div>
      <div class="flex justify-between">
        <span class="text-slate-400">Status:</span>
        <span class="font-bold <%= type === 'changes' ? 'text-amber-700' : 'text-emerald-700' %>">
          <%= type === 'changes' ? 'Changes Submitted' : 'All Dates Confirmed' %>
        </span>
      </div>
    </div>

    <!-- Return or Close Note -->
    <p class="text-xs text-slate-400 mt-6">
      You may now close this browser tab. If you ever need to revise your dates before dispatch, simply reopen your review link.
    </p>

    <div class="mt-6 pt-6 border-t border-slate-100 flex items-center justify-center space-x-2 text-slate-400 text-xs">
      <span class="font-bold text-slate-700">PLASGAIN</span>
      <span>&bull;</span>
      <span>Quality Underground & Infrastructure Solutions</span>
    </div>
  </div>
</body>
</html>
